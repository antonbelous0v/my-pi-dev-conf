#!/bin/sh
set -eu

name=${1:-}
base=${2:-HEAD}
case "$name" in
  ""|*[!a-zA-Z0-9._-]*)
    printf 'Usage: pi-worktree <name> [base-ref]\n' >&2
    exit 2
    ;;
esac

root=$(git rev-parse --show-toplevel)
repo=$(basename "$root")
target="$HOME/.pi/worktrees/$repo-$name"
branch="pi/$name"

if [ -e "$target" ]; then
  printf 'Worktree already exists: %s\n' "$target" >&2
  exit 1
fi

mkdir -p "$HOME/.pi/worktrees"
git -C "$root" worktree add -b "$branch" "$target" "$base"
cd "$target"
exec pi --name "$name"
